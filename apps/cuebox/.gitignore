# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# prisma
/prisma/*.db
/prisma/*.db-journal

# vercel
.vercel

# generated ChatGPT widget bundle
/public/cuebox-prompt-card-v1.js

# typescript
*.tsbuildinfo
next-env.d.ts
