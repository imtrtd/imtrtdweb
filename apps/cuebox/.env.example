# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string

# Prisma PostgreSQL
# Local (docker compose up -d):
DATABASE_URL="postgresql://cuebox:cuebox@localhost:5432/cuebox?schema=public"
DATABASE_URL_UNPOOLED="postgresql://cuebox:cuebox@localhost:5432/cuebox?schema=public"
# Neon / Vercel: use the pooled URL as DATABASE_URL and the
# direct / unpooled URL as DATABASE_URL_UNPOOLED (required for migrations).

# Public app URL for Auth.js in production
AUTH_URL=https://app.imtryingtodesign.com

# Public origin used in Cuebox MCP result URLs and widget CSP.
# Set this to the HTTPS tunnel URL during ChatGPT Developer Mode testing.
CUEBOX_PUBLIC_URL=https://app.imtryingtodesign.com
