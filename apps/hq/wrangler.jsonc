/**
 * HQ Worker: imtrtd.space (http->https, *.html->clean 301, security headers) in front of the
 * Astro build in ./dist (npm run build). Source: src/ (pages, components, data).
 * Unknown paths get dist/404.html with status 404 (not_found_handling: 404-page).
 * Deployed by .github/workflows/deploy-hq.yml.
 */
{
	"$schema": "https://unpkg.com/wrangler@4.88.0/config-schema.json",
	"name": "imtrtd-hq",
	"main": "./worker/index.js",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	},
	"routes": [
		{
			"pattern": "imtrtd.space",
			"custom_domain": true
		},
		{
			"pattern": "www.imtrtd.space",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	}
}
