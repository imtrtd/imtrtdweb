---
/**
 * /apps/cuebox — Cuebox, the AI prompt library, as a local-first web app in the imtrtd design system.
 * The full product (accounts, Postgres, MCP) lives at app.imtryingtodesign.com; this one keeps the
 * library in localStorage. Logic: src/scripts/cuebox.ts.
 */
import AppPage from "../../layouts/AppPage.astro";
---

<AppPage
  title="Cuebox — a prompt library — IMTRTD"
  app="Cuebox"
  description="Write a prompt once, fill its blanks, send it to whichever AI you are talking to today. Kept in your browser."
  path="/apps/cuebox"
  icon="/images/apps/cuebox-180.png"
>
  <header class="ap-head">
    <p class="sec-index label">Cuebox · AI working library</p>
    <h1 class="ap-title">Write it once.<br />Paste it forever.</h1>
    <p class="ap-lead">
      Prompts that work, sorted by the AI they work on. Mark the blanks <code class="cb-code">{"{{like this}}"}</code>, fill them in before sending, then copy or open straight in ChatGPT, Claude or
      Perplexity. Retyping is for people with time.
    </p>
    <div class="ap-row">
      <button type="button" class="btn btn-primary btn-lg" data-cb-new>+ New prompt</button>
      <button type="button" class="btn btn-ghost btn-lg" data-cb-export>Export</button>
      <button type="button" class="btn btn-ghost btn-lg" data-cb-import>Import</button>
      <input type="file" accept="application/json,.json" data-cb-file hidden />
    </div>
  </header>

  <p class="ap-alert" data-cb-storage hidden>This browser won’t store anything (private mode?). The library leaves with the tab.</p>

  <section aria-labelledby="h-lib" class="cb-lib">
    <div class="cb-tools">
      <h2 id="h-lib" class="sec-index label">Library</h2>
      <label class="cb-search"><span class="sr-only">Search</span><input type="search" class="field" placeholder="Search titles, text, tags" data-cb-q autocomplete="off" /></label>
    </div>
    <div class="ap-seg" role="group" aria-label="Folders" data-cb-folders></div>
    <ul class="cb-grid" data-cb-list></ul>
    <div class="cb-empty card" data-cb-empty hidden>
      <p class="cb-empty-title">Empty.</p>
      <p class="ap-note" data-cb-empty-note>Nothing in this folder yet.</p>
      <div class="ap-row"><button type="button" class="btn btn-primary" data-cb-new>Create a prompt</button></div>
    </div>
  </section>

  <section aria-labelledby="h-how">
    <h2 id="h-how" class="sec-index label ap-h">Variables</h2>
    <ol class="cb-how">
      <li><span class="label text-signal">01</span><p><code class="cb-code">{"{{topic}}"}</code> is a blank you fill in before sending.</p></li>
      <li><span class="label text-signal">02</span><p><code class="cb-code">{"{{tone:friendly}}"}</code> comes pre-filled, for when you agree with yourself.</p></li>
      <li><span class="label text-signal">03</span><p>Same name, same value: fill it once, however often it repeats.</p></li>
    </ol>
  </section>

  <Fragment slot="after">
    <dialog class="ap-dialog" data-cb-editor aria-label="Prompt editor"></dialog>
    <dialog class="ap-dialog" data-cb-use aria-label="Fill in variables"></dialog>
  </Fragment>
</AppPage>

<style is:global>
  .cb-code { font-family: var(--font-mono); font-size: 0.85em; color: var(--color-signal); }
  .cb-lib { display: grid; gap: 1rem; }
  .cb-tools { display: grid; gap: 0.75rem; }
  @media (width >= 48rem) { .cb-tools { grid-template-columns: 1fr minmax(0, 26rem); align-items: center; } }
  .cb-grid { display: grid; border-top: 1px solid var(--color-hair); border-left: 1px solid var(--color-hair); }
  @media (width >= 40rem) { .cb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width >= 64rem) { .cb-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cb-grid > li { display: grid; grid-template-rows: auto auto 1fr auto auto; gap: 0.6rem; padding: 1rem; background: rgb(10 10 15 / 0.6); border-right: 1px solid var(--color-hair); border-bottom: 1px solid var(--color-hair); min-width: 0; }
  .cb-meta { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  .cb-star { min-width: 2.25rem; min-height: 2.25rem; font-size: 1.1rem; color: var(--color-mute); }
  .cb-star[aria-pressed="true"] { color: var(--color-signal); }
  .cb-title { font-family: var(--font-display); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.015em; line-height: 1.2; overflow-wrap: anywhere; }
  .cb-body { font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.55; color: var(--color-mute); white-space: pre-wrap; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; max-height: calc(1.55em * 4); }
  .cb-body mark { background: none; color: var(--color-signal); }
  .cb-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cb-acts { display: flex; flex-wrap: wrap; gap: 0.4rem; padding-top: 0.6rem; border-top: 1px solid var(--color-hair); }
  .cb-acts .btn { min-height: 2.5rem; padding: 0 0.85rem; font-size: 0.68rem; }
  .cb-empty { display: grid; gap: 0.75rem; padding: 1.5rem; }
  .cb-empty-title { font-family: var(--font-display); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.02em; }
  .cb-how { display: grid; gap: 1px; border: 1px solid var(--color-hair); background: var(--color-hair); }
  @media (width >= 40rem) { .cb-how { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cb-how > li { display: grid; gap: 0.5rem; align-content: start; padding: 1.25rem; background: rgb(10 10 15 / 0.92); color: var(--color-fog); font-size: 0.92rem; line-height: 1.5; }
  .cb-vars { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cb-preview { padding: 1rem; border: 1px solid var(--color-hair); background: rgb(10 10 15 / 0.55); font-family: var(--font-mono); font-size: 0.82rem; line-height: 1.6; white-space: pre-wrap; overflow-wrap: anywhere; max-height: 16rem; overflow: auto; }
</style>

<script>
  import "../../scripts/cuebox.ts";
</script>
