---
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import { apps } from "../../data/apps";
---

<Base
  title="Apps — IMTRTD"
  description="Small tools from the studio, open in the browser: Cuebox, Pulse, CommandDir, and a live preview of I/TD shell."
  path="/apps"
>
  <section class="sec" style="border-top:0" aria-labelledby="h-apps">
    <div class="wrap">
      <SectionHead index="01" kicker="Apps" id="h-apps" title="Small tools I actually use." lead="They run in the browser, on a phone or a laptop. No accounts: what you make stays on your device and leaves only by Export." />
      <ul class="grid gap-px border border-hair bg-hair sm:grid-cols-2 xl:grid-cols-4">
        {
          apps.map((a, i) => (
            <li class="relative flex flex-col bg-ink" data-reveal={i % 4}>
              <a href={a.href} class="group flex flex-1 flex-col">
                <span class="app-shot relative block aspect-[16/10] overflow-hidden border-b border-hair bg-ink-soft" aria-hidden="true">
                  {a.shot ? (
                    <picture>
                      <source type="image/webp" srcset={`/images/apps/${a.shot}-card.webp`} />
                      <img src={`/images/apps/${a.shot}-card.jpg`} width="720" height="450" alt="" loading={i < 2 ? "eager" : "lazy"} decoding="async" class="h-full w-full object-cover object-top opacity-85 transition duration-500 group-hover:scale-[1.03] group-hover:opacity-100" />
                    </picture>
                  ) : (
                    <span class="app-term">
                      <span class="app-term-bar"><i /><i /><i /><span>i/td shell</span></span>
                      <span class="app-term-body">
                        <span><b>~</b> itd --version</span>
                        <span class="text-mute">not yet. soon.</span>
                        <span><b>~</b> itd notify --when ready</span>
                        <span class="text-mute">noted.</span>
                        <span><b>~</b> <em class="app-caret" /></span>
                      </span>
                    </span>
                  )}
                </span>
                <span class="flex flex-1 flex-col gap-3 p-5">
                  <span class="label text-signal">{String(i + 1).padStart(2, "0")} · {a.kind}</span>
                  <span class="flex items-center gap-3">
                    <span class="grid size-11 shrink-0 place-items-center border border-hair-strong font-display text-base font-semibold tracking-tight text-signal transition-colors group-hover:border-signal" aria-hidden="true">{a.mono}</span>
                    <span class="min-w-0">
                      <span class="block font-display text-2xl leading-tight font-semibold tracking-tight transition-colors group-hover:text-signal">{a.name}</span>
                      <span class="mt-0.5 block text-sm text-fog">{a.line}</span>
                    </span>
                  </span>
                  <span class="text-sm leading-relaxed text-mute">{a.text}</span>
                  <span class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t border-hair pt-3">
                    <span class="flex flex-wrap gap-1.5">{a.facts.slice(0, 2).map((f) => <span class="chip">{f}</span>)}</span>
                    <span class="label inline-flex items-center gap-2 text-signal">{a.soon ? "Notify me" : "Open"} <span class="arrow" aria-hidden="true">→</span></span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-mute">Clearing site data clears your work too. Export first; future you will be grateful.</p>
    </div>
  </section>
</Base>
