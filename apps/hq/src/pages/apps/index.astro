---
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import { apps } from "../../data/apps";
---

<Base
  title="Apps — IMTRTD"
  description="Small tools from the studio, open in the browser: Cuebox, Pulse, Komandir. I/TD shell is on its way."
  path="/apps"
>
  <section class="sec" style="border-top:0" aria-labelledby="h-apps">
    <div class="wrap">
      <SectionHead index="01" kicker="Apps" id="h-apps" title="Small tools I actually use." lead="They run in the browser, on a phone or a laptop. No accounts: what you make stays on your device and leaves only by Export." />
      <ul class="grid gap-px border border-hair bg-hair md:grid-cols-2">
        {
          apps.map((a, i) => (
            <li class="relative flex flex-col bg-ink" data-reveal={i % 2}>
              <a href={a.href} class="group flex flex-1 flex-col gap-5 p-6 lg:p-8">
                <span class="flex items-start justify-between gap-4">
                  <span class="label text-signal">{String(i + 1).padStart(2, "0")} · {a.kind}</span>
                  {a.soon && <span class="chip text-signal">Soon</span>}
                </span>
                <span class="flex items-center gap-5">
                  <span class="grid size-16 shrink-0 place-items-center border border-hair-strong font-display text-2xl font-semibold tracking-tight text-signal transition-colors group-hover:border-signal lg:size-20 lg:text-3xl" aria-hidden="true">
                    {a.mono}
                  </span>
                  <span class="min-w-0">
                    <span class="block font-display text-3xl font-semibold tracking-tight transition-colors group-hover:text-signal lg:text-4xl">{a.name}</span>
                    <span class="mt-1 block text-sm text-fog">{a.line}</span>
                  </span>
                </span>
                <span class="max-w-[52ch] text-sm leading-relaxed text-mute">{a.text}</span>
                <span class="mt-auto flex flex-wrap items-center justify-between gap-3 border-t border-hair pt-4">
                  <span class="flex flex-wrap gap-1.5">{a.facts.map((f) => <span class="chip">{f}</span>)}</span>
                  <span class="label inline-flex items-center gap-2 text-signal">{a.soon ? "Notify me" : "Open"} <span class="arrow" aria-hidden="true">→</span></span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-mute">Clearing site data clears your work too. Export first; future you will be grateful.</p>
    </div>
  </section>
</Base>
