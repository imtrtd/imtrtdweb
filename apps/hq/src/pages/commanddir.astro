---
/**
 * /commanddir — CommandDir: build your own commands from steps and run them in one tap.
 * Web version of the iOS app of the same name. Standalone page in the /launcher style (no site
 * header/footer/starfield), installable to the home screen, not indexed. Commands live in this
 * browser's localStorage only; logic in src/scripts/commanddir.ts.
 */
import "../styles/global.css";
import "../styles/commanddir.css";

const accents = [
  { id: "violet", color: "#b28dff" },
  { id: "lime", color: "#d8ff00" },
  { id: "magenta", color: "#ff2bd6" },
  { id: "cyan", color: "#2ee9ff" },
];

const how = [
  { k: "01", h: "Build", p: "A command is steps in order: open a link or an app, call, text, speak, ask, wait." },
  { k: "02", h: "Run", p: "One tap and the steps go in turn. When the browser insists on a tap of its own, you get a button." },
  { k: "03", h: "Take it out", p: "Every command has a link. Put it on the Home Screen or into iOS Shortcuts." },
];
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        var a = localStorage.getItem("imtrtd-accent");
        if (a === "lime" || a === "magenta" || a === "cyan") document.documentElement.dataset.accent = a;
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>CommandDir — commands in one tap — IMTRTD</title>
    <meta name="description" content="Chain steps (a link, an app, a call, a text, a voice, a pause) into a command and run it in one tap." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://imtrtd.space/commanddir" />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/geist-mono-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CommandDir" />
    <link rel="manifest" href="/commanddir.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/commanddir/icon-180.png" />
  </head>
  <body class="km">
    <main class="km-wrap">
      <header class="km-head">
        <a href="/" class="km-home label" aria-label="imtrtd.space, home">
          <img src="/brand/logo-mark.svg" alt="" width="28" height="28" />
          <span>imtrtd.space</span>
        </a>
        <p class="sec-index label">CommandDir</p>
        <h1 class="km-title">Your commands.<br />One tap each.</h1>
        <p class="km-lead">
          Chain a few steps (open a site or an app, call, text, read aloud, wait) and run them from here, the Home Screen or iOS Shortcuts. Like a macro, minus the manual.
        </p>
        <div class="km-row km-actions">
          <button type="button" class="btn btn-primary btn-lg" data-km-new>+ New command</button>
          <button type="button" class="btn btn-ghost btn-lg" data-km-tpl>Templates</button>
        </div>
      </header>

      <p class="km-alert" data-km-missing hidden>
        No “<b data-km-missing-name></b>” in this browser. Commands live on the device that made them: move them with Export.
      </p>
      <p class="km-alert" data-km-storage hidden>This browser won’t store anything (private mode?). Commands vanish with the tab.</p>

      <section aria-labelledby="h-list">
        <h2 id="h-list" class="sec-index label km-h">My commands</h2>
        <ul class="km-grid" data-km-list hidden></ul>
        <div class="km-empty card clip-corner" data-km-empty>
          <p class="km-empty-title">No commands yet.</p>
          <p class="km-note">Start from a template (Quick note, Heading home, Break) or from nothing at all.</p>
          <div class="km-row">
            <button type="button" class="btn btn-primary" data-km-new>Create</button>
            <button type="button" class="btn btn-ghost" data-km-tpl>Pick a template</button>
          </div>
        </div>
      </section>

      <section aria-labelledby="h-how">
        <h2 id="h-how" class="sec-index label km-h">How it works</h2>
        <ol class="km-how">
          {
            how.map((s) => (
              <li>
                <span class="label text-signal">{s.k}</span>
                <h3 class="km-how-h">{s.h}</h3>
                <p class="km-note">{s.p}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <details class="km-more card">
        <summary class="label">Variables, links, moving house</summary>
        <div class="km-more-body">
          <div>
            <p class="label text-mute">Variables</p>
            <dl class="km-vars-list">
              <dt>{"{{date}}"}</dt><dd>today</dd>
              <dt>{"{{time}}"}</dt><dd>now</dd>
              <dt>{"{{clipboard}}"}</dt><dd>whatever you copied last</dd>
              <dt>{"{{input}}"}</dt><dd>the answer from an Ask step</dd>
            </dl>
          </div>
          <div>
            <p class="label text-mute">Run by link</p>
            <p class="km-note">
              <code class="km-code">imtrtd.space/commanddir?run=Name</code> opens a command; Run starts it. In iOS Shortcuts, use Open URL with that link. Each command’s editor
              copies its own.
            </p>
          </div>
          <div>
            <p class="label text-mute">Home Screen</p>
            <p class="km-note">Safari → Share → Add to Home Screen. CommandDir then opens full screen, like an app that never asked for permission.</p>
          </div>
          <div>
            <p class="label text-mute">Moving and backup</p>
            <p class="km-note">Commands stay in this browser and go nowhere. To move them: export here, import there.</p>
            <div class="km-row">
              <button type="button" class="btn btn-ghost" data-km-export>Export</button>
              <button type="button" class="btn btn-ghost" data-km-import>Import</button>
              <input type="file" accept="application/json,.json" data-km-file hidden />
            </div>
          </div>
          <div>
            <p class="label text-mute">Colour</p>
            <div class="km-accents" role="radiogroup" aria-label="Accent colour">
              {accents.map((a) => <button type="button" role="radio" aria-label={a.id} data-accent-pick={a.id} style={`--c:${a.color}`} />)}
            </div>
          </div>
        </div>
      </details>

      <footer class="km-foot label">
        <span>I/TD · imtrtd.space</span>
        <a href="/contact">Contact</a>
      </footer>
    </main>

    <dialog class="km-dialog" data-km-editor aria-label="Command editor"></dialog>
    <dialog class="km-dialog" data-km-picker aria-label="Pick a step"></dialog>
    <dialog class="km-dialog" data-km-templates aria-label="Templates"></dialog>
    <dialog class="km-dialog" data-km-run aria-label="Running a command"></dialog>

    <script>
      import "../scripts/commanddir.ts";
    </script>
  </body>
</html>
