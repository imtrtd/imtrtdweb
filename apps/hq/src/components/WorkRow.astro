---
/**
 * One line of the "Selected work" list on the home page: the original imtrtd.space row
 * (index, kind · place, title, one line, Preview). On desktop it sits on the section-head grid: the live-build
 * thumbnail under the kicker column, the text under the heading.
 */
import type { Case } from "../data/cases";

interface Props {
  c: Case;
  index: number;
}
const { c, index } = Astro.props;
const n = String(index + 1).padStart(2, "0");
const img = `/images/previews/${c.preview}`;
---

<li class="work-row group relative border-b border-hair" data-reveal={index % 3}>
  <span class="wr-media">
    <span class="wr-n label text-signal">{n}</span>
    <picture class="wr-pic relative hidden aspect-[16/10] overflow-hidden border border-hair bg-ink-soft md:block" aria-hidden="true">
      <source type="image/webp" srcset={`${img}-n.webp`} />
      <img src={`${img}-n.jpg`} width="900" height="563" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-top opacity-80 transition duration-500 group-hover:scale-[1.04] group-hover:opacity-100" />
    </picture>
  </span>
  <span class="wr-body">
    <span class="wr-text min-w-0">
      <span class="label text-mute">{c.kind} · {c.place}</span>
      <a href={`/work/${c.slug}`} class="mt-1 block font-display text-2xl font-semibold tracking-tight break-words transition-colors group-hover:text-signal sm:text-3xl lg:text-4xl after:absolute after:inset-0">{c.title}</a>
      <span class="wr-sum mt-2 block max-w-[54ch] text-sm leading-relaxed text-mute">{c.summary}</span>
    </span>
    <span class="wr-cta label relative inline-flex h-11 w-full shrink-0 items-center justify-center bg-signal px-5 text-ink transition-transform duration-200 group-hover:-translate-y-px md:w-auto">Preview</span>
  </span>
</li>
