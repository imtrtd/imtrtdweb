---
import { nav } from "../data/site";

const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/") || "/";
const isActive = (href: string) => (href === "/" ? here === "/" : here === href || here.startsWith(href + "/") || (href === "/selected" && here.startsWith("/work/")));

const accents = [
  { id: "lime", label: "Lime", color: "#d8ff00" },
  { id: "violet", label: "Violet", color: "#b28dff" },
  { id: "magenta", label: "Magenta", color: "#ff2bd6" },
  { id: "cyan", label: "Cyan", color: "#2ee9ff" },
];
const swatch = "polygon(0 0, calc(100% - 4px) 0, 100% 4px, 100% 100%, 4px 100%, 0 calc(100% - 4px))";
---

<header class="sticky top-0 z-40 border-b border-hair bg-ink/85 backdrop-blur-sm">
  <div class="wrap grid grid-cols-[auto_1fr_auto] items-center gap-x-3 py-1.5 lg:py-2.5">
    <a href="/" aria-label="ImTryingToDesign, home" data-fx="logo" class="group inline-flex items-center gap-3 py-1">
      <!-- inline, so the mark paints with the header instead of arriving as a second request -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 959 978" width="56" height="56" class="size-9 shrink-0 lg:size-11" aria-hidden="true"><path fill="#E0F725" d="M0 0H822L959 137V978H128L0 850Z"/><path fill="#000" d="M157 606V567.03H201.81V407.97H157V369H289V407.97H244.19V567.03H289V606Z M336 632 437.37 361H479L377.63 632Z M509 369H652V410H605V606H557V410H509Z M688 606V369H755.44Q777.71 369 794.18 378.28Q810.66 387.56 819.83 404.37Q829 421.18 829 443.96V530.72Q829 553.24 819.83 570.21Q810.66 587.18 794.18 596.59Q777.71 606 755.44 606ZM728.86 564.59H755.44Q770.34 564.59 779.24 555.41Q788.14 546.23 788.14 530.72V443.96Q788.14 428.77 779.24 419.59Q770.34 410.41 755.44 410.41H728.86Z"/></svg>
      <span class="label text-fog transition-colors group-hover:text-paper max-[359px]:hidden" aria-hidden="true">imtrtd.space</span>
    </a>

    <nav aria-label="Main" class="col-span-3 row-start-2 -mx-4 flex gap-x-5 overflow-x-auto px-4 [scrollbar-width:none] lg:col-span-1 lg:col-start-2 lg:row-start-1 lg:mx-0 lg:justify-end lg:gap-x-6 lg:px-0 lg:pr-5">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-fx={item.fx}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={["nav-link label inline-flex h-11 shrink-0 items-center transition-colors duration-200 hover:text-paper", isActive(item.href) ? "text-paper" : "text-mute"]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="col-start-3 flex items-center justify-end gap-1 lg:border-l lg:border-hair lg:pl-4">
      <button type="button" data-sound="true" aria-pressed="false" class="label inline-flex h-11 items-center gap-2 px-1 text-mute transition-colors hover:text-paper">
        <span class="snd-dot size-1.5 rounded-full bg-mute"></span><span class="max-sm:sr-only">Sound</span>
      </button>
      <div role="radiogroup" aria-label="Site colour" class="flex items-center">
        {
          accents.map((a) => (
            <button type="button" role="radio" aria-checked={a.id === "violet" ? "true" : "false"} aria-label={a.label} data-fx={a.id} class="grid size-8 place-items-center sm:size-9">
              <span class={a.id === "violet" ? "size-3.5 ring-2 ring-paper ring-offset-2 ring-offset-ink" : "size-3.5 opacity-80"} style={`background:${a.color};clip-path:${swatch}`} />
            </button>
          ))
        }
      </div>
    </div>
  </div>
</header>
