---
import { packages } from "../data/offer";
---

<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  {
    packages.map((p, i) => (
      <li
        class:list={["card flex flex-col p-6 lg:p-7", p.featured && "border-signal shadow-[0_0_0_1px_var(--color-signal),0_30px_80px_-40px_var(--color-signal)]"]}
        data-reveal={i}
      >
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-2xl font-semibold tracking-tight">{p.name}</h3>
          {p.featured && <span class="chip border-signal text-signal">Most asked</span>}
        </div>
        <p class="mt-3 text-sm leading-relaxed text-fog">{p.for}</p>
        <ul class="mt-6 grid gap-2.5 border-t border-hair pt-5 text-sm">
          {p.includes.map((x) => (
            <li class="flex gap-2.5">
              <span class="mt-[0.45em] size-1.5 shrink-0 bg-signal" aria-hidden="true" />
              <span>{x}</span>
            </li>
          ))}
        </ul>
        <div class="mt-auto pt-7">
          <p class="label text-mute">Price</p>
          <p class="mt-1.5 font-display text-xl font-semibold">{p.price ?? "Quoted after the sample"}</p>
          <a href={`/contact?type=${encodeURIComponent(p.task)}#brief`} class:list={["btn mt-5 w-full", p.featured ? "btn-primary" : "btn-ghost"]} data-fx="send">
            Ask about {p.name} <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>
