---
/**
 * Standalone page frame for the apps under /apps (Cuebox, Pulse): no site header/footer/starfield,
 * installable to the home screen, the site accent, a crumb bar back to /apps. Data of each app
 * lives in this browser's localStorage only.
 */
import "../styles/global.css";
import "../styles/apps.css";

interface Props {
  title: string;
  /** Name in the crumb bar and on the home screen. */
  app: string;
  description: string;
  path: string;
  icon?: string;
}
const { title, app, description, path, icon = "/apple-touch-icon.png" } = Astro.props;
const accents = [
  { id: "violet", color: "#b28dff" },
  { id: "lime", color: "#d8ff00" },
  { id: "magenta", color: "#ff2bd6" },
  { id: "cyan", color: "#2ee9ff" },
];
---

<!doctype html>
<html lang="en" class="antialiased">
  <head>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        var a = localStorage.getItem("imtrtd-accent");
        if (a === "lime" || a === "magenta" || a === "cyan") document.documentElement.dataset.accent = a;
      } catch (e) {}
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://imtrtd.space${path}`} />
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/geist-mono-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={app} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={icon} />
  </head>
  <body class="ap">
    <main class="ap-wrap">
      <nav class="ap-bar" aria-label="Navigation">
        <span class="ap-crumbs label">
          <a href="/" aria-label="imtrtd.space, home"><img src="/brand/logo-mark.svg" alt="" width="28" height="28" /></a>
          <a href="/apps">Apps</a><span aria-hidden="true">/</span><span class="text-paper">{app}</span>
        </span>
        <span class="ap-accents" role="radiogroup" aria-label="Accent colour" style="gap:0.25rem">
          {accents.map((a) => <button type="button" role="radio" aria-label={a.id} data-accent-pick={a.id} style={`--c:${a.color};width:1.75rem;height:1.75rem`} />)}
        </span>
      </nav>
      <slot />
      <footer class="ap-foot label">
        <span>I/TD · {app} · your data stays in this browser</span>
        <span class="ap-row"><a href="/apps">All apps</a><a href="/contact">Contact</a></span>
      </footer>
    </main>
    <div class="ap-toast" role="status" aria-live="polite" data-ap-toast></div>
    <slot name="after" />
    <script>
      import "../scripts/apps-common.ts";
    </script>
  </body>
</html>
