/**
 * Studio Worker — Proton Cloudflare account (custom domain).
 * Durable Object SQLite store (no D1 on this account).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imtrtdweb",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"routes": [
		{
			"pattern": "admin.imtrtd.space",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "APP_STORE",
				"class_name": "AppStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["WorkflowStatusDO"],
			"new_sqlite_classes": ["AppStore"]
		}
	],
	// Lead emails: sender must be on a zone with Email Routing (imtryingtodesign.com); recipient must be a verified destination address.
	"send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["admin@imtrtd.space"] }],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"STUDIO_NOTIFY_EMAIL": "admin@imtrtd.space",
		"LEAD_NOTIFY_EMAIL": "admin@imtrtd.space",
		"LEAD_FROM_EMAIL": "leads@imtryingtodesign.com",
		// Turnstile on the imtrtd.space brief forms (PSE-22). Public site key from the Turnstile widget goes here;
		// the secret is set with `wrangler secret put TURNSTILE_SECRET_KEY`. Empty key or no secret = check off.
		"TURNSTILE_SITE_KEY": ""
	},
	"upload_source_maps": true
}
