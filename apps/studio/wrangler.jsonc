/**
 * Production Worker for Unitl@proton.me account (active domain zone).
 * Uses Durable Object SQLite store instead of D1 (token lacks D1 permission).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imtrtdweb",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "APP_STORE",
				"class_name": "AppStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["WorkflowStatusDO"],
			"new_sqlite_classes": ["AppStore"]
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"STUDIO_NOTIFY_EMAIL": "hello@imtryingtodesign.com"
	},
	"upload_source_maps": true
}
