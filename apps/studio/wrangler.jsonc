/**
 * Cloudflare Worker config for imtrtdweb studio app.
 * Primary account: b6f57d806… (D1 + workers.dev).
 * Falls back to Durable Object SQLite when DB binding is absent.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imtrtdweb",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imtrtdweb",
			"database_id": "64e84c88-3ece-4f03-afe0-cf4dd9bef52b"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "APP_STORE",
				"class_name": "AppStore"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowStatusDO"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["WorkflowStatusDO"],
			"new_sqlite_classes": ["AppStore"]
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"STUDIO_NOTIFY_EMAIL": "hello@imtryingtodesign.com"
	},
	"upload_source_maps": true
}
