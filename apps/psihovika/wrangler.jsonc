{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psy",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
