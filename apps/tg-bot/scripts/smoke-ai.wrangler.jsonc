/**
 * Ephemeral config for AI smoke only — no Durable Objects, assets, or cron.
 * Auth: CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID (same as deploy).
 */
{
  "name": "tg-bot-smoke-ai",
  "main": "./smoke-ai-worker.ts",
  "compatibility_date": "2026-08-10",
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/openai/gpt-oss-20b"
  }
}
