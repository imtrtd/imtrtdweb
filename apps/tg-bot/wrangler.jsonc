/**
 * Telegram group bot @GrokAssistant_ai for the "Главная" forum supergroup.
 * Webhook + Mini App (/app) + reminders cron. Storage: Durable Object SQLite (no D1 on this account).
 * Deployed by .github/workflows/deploy-tg-bot.yml.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namenlos-tg-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // Guide pictures/GIFs (public/guide-media). Files are served directly; everything else goes to the Worker.
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "BotStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BotStore"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "BOT_ID": "8877042004",
    "BOT_USERNAME": "GrokAssistant_ai",
    "OWNER_ID": "8970219861",
    "HOME_CHAT_ID": "-1004331076673",
    "FORUM_TOPICS": "{\"10\":\"Задачи\",\"11\":\"🖋 Тату: записи\",\"12\":\"💰 Учёт и деньги\",\"13\":\"📁 Проекты\",\"14\":\"💡 Идеи\"}",
    "TIMEZONE": "Europe/Kiev",
    "PUBLIC_URL": "https://namenlos-tg-bot.unitl.workers.dev",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_FALLBACK_MODEL": "@cf/meta/llama-3.1-8b-instruct"
  }
}
