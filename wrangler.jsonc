/**
 * After creating cloud resources, replace placeholders:
 *   npx wrangler d1 create imtrtdweb
 *   npx wrangler r2 bucket create imtrtdweb-media
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imtrtdweb",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	/**
	 * Apex custom domain blocked while zone NS are mismatched / existing DNS present.
	 * Attach hostnames after NS are active, e.g.:
	 *   npx wrangler domains add www.imtryingtodesign.com
	 */
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imtrtdweb",
			"database_id": "64e84c88-3ece-4f03-afe0-cf4dd9bef52b",
			"migrations_dir": "migrations"
		}
	],
	/**
	 * Re-enable after R2 is turned on in the Cloudflare Dashboard:
	 *   npx wrangler r2 bucket create imtrtdweb-media
	 *
	 * "r2_buckets": [
	 *   { "binding": "MEDIA", "bucket_name": "imtrtdweb-media" }
	 * ],
	 */
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"STUDIO_NOTIFY_EMAIL": "hello@imtryingtodesign.com"
	},
	"upload_source_maps": true
}
