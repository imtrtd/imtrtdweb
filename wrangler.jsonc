{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imtryingtodesign-public",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "imtryingtodesign.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
