/**
 * After creating cloud resources, replace placeholders:
 *   npx wrangler d1 create imtrtdweb
 *   npx wrangler r2 bucket create imtrtdweb-media
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "imtrtdweb",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-10",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"routes": [
		{
			"pattern": "imtryingtodesign.com",
			"custom_domain": true
		}
	],
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "imtrtdweb",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "imtrtdweb-media"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"vars": {
		"STUDIO_NOTIFY_EMAIL": "hello@imtryingtodesign.com"
	},
	"upload_source_maps": true
}
